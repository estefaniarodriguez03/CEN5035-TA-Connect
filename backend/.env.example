# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=officehours

# Auth: used to sign JWTs (use a long random string in production)
JWT_SECRET=your_jwt_secret_change_in_production

# Zoom app > Meetings > Personal Meeting Room > Copy invite link, e.g.
# Every TA-started session will hand this URL to the student.
ZOOM_JOIN_URL=
# Optional: separate host launcher URL. Falls back to ZOOM_JOIN_URL when unset.
ZOOM_START_URL=
